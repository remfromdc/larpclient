<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:local="clr-namespace:LarpClient" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="LarpClient.MainWindow" Title="LarpClient" Width="1180" Height="790" MinWidth="990" MinHeight="700" WindowStyle="None" ResizeMode="CanResize" Background="#060606" Foreground="#F4F4F4" FontFamily="pack://application:,,,/Assets/Fonts/#Nunito" FontSize="13" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" Loaded="WindowLoaded" KeyDown="WindowKeyDown" FontWeight="SemiBold" TextOptions.TextRenderingMode="ClearType" TextOptions.TextHintingMode="Fixed">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="58" ResizeBorderThickness="6" CornerRadius="22" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Grid Background="Transparent" Margin="1,4">
              <Track x:Name="PART_Track" IsDirectionReversed="True" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Opacity="0" Focusable="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Border x:Name="ScrollThumb" Background="#383838" CornerRadius="3" />
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ScrollThumb" Property="Background" Value="#606060" />
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Opacity="0" Focusable="False" />
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <SolidColorBrush x:Key="Muted" Color="#969696" />
    <SolidColorBrush x:Key="Surface" Color="#101010" />
    <SolidColorBrush x:Key="RaisedSurface" Color="#161616" />
    <SolidColorBrush x:Key="FieldSurface" Color="#090909" />
    <SolidColorBrush x:Key="SurfaceBorder" Color="#292929" />
    <SolidColorBrush x:Key="HoverBorder" Color="#565656" />
    <SolidColorBrush x:Key="SelectedSurface" Color="#1C1C1C" />
    <SolidColorBrush x:Key="SelectedBorder" Color="#666666" />
    <Style TargetType="Button">
      <EventSetter Event="Loaded" Handler="ButtonLoaded" />
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#EEEEEE" />
      <Setter Property="Background" Value="{StaticResource RaisedSurface}" />
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="16,12" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <ScaleTransform x:Name="ButtonScale" />
              </Border.RenderTransform>
              <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                  <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.14">
                      <VisualTransition.GeneratedEasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                  </VisualStateGroup.Transitions>
                  <VisualState x:Name="Normal">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0" />
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="MouseOver">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.008" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.008" Duration="0" />
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Pressed">
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="0.98" Duration="0" />
                      <DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="0.98" Duration="0" />
                    </Storyboard>
                  </VisualState>
                  <VisualState x:Name="Disabled" />
                </VisualStateGroup>
              </VisualStateManager.VisualStateGroups>
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{StaticResource HoverBorder}" />

              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Surface" Property="Opacity" Value="0.35" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#1B1B1B" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="NavigationButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Width" Value="168" />
      <Setter Property="Height" Value="54" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Padding" Value="16,0" />
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#111111" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E5E5E5" />
      <Setter Property="Margin" Value="0,14" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="46" />
              </Grid.ColumnDefinitions>
              <ContentPresenter VerticalAlignment="Center" />
              <Border x:Name="Track" Grid.Column="1" Height="24" CornerRadius="12" Background="#303030">
                <Ellipse x:Name="Thumb" Width="16" Height="16" HorizontalAlignment="Left" Margin="4,0" Fill="#8D8D8D" />
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Track" Property="Background" Value="#DEDEDE" />
                <Setter TargetName="Thumb" Property="Fill" Value="#232323" />
                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Track" Property="BorderBrush" Value="White" />
                <Setter TargetName="Track" Property="BorderThickness" Value="1" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="FontSize" Value="14" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Background" Value="{StaticResource FieldSurface}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="{StaticResource SurfaceBorder}" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CaretBrush" Value="White" />
      <Setter Property="SelectionBrush" Value="#6A6A6A" />
      <Setter Property="SelectionOpacity" Value="0.5" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Field" Property="BorderBrush" Value="#BABABA" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBox">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
              <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}" CanContentScroll="True">
                <ItemsPresenter />
              </ScrollViewer>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ListBoxItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,10" />
      <Setter Property="Foreground" Value="#F4F4F4" />
      <Setter Property="Background" Value="{StaticResource RaisedSurface}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Card" CornerRadius="14" Background="{TemplateBinding Background}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" Padding="14,16">
              <ContentPresenter />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="Background" Value="{StaticResource SelectedSurface}" />
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource SelectedBorder}" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource HoverBorder}" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="InstanceCard">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="42" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Width="32" Height="34" Background="#252525" CornerRadius="8" VerticalAlignment="Center">
          <Path Data="M 2,6 L 12,1 22,6 22,18 12,23 2,18 Z M 2,6 L 12,11 22,6 M 12,11 L 12,23" Stroke="#E5E5E5" StrokeThickness="1.4" Width="20" Height="22" Stretch="Uniform" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{Binding Version}" Foreground="{StaticResource Muted}" FontSize="13" Margin="0,4,0,0" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <Style TargetType="RadioButton">
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Foreground" Value="#BFBFBF" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Border x:Name="Segment" Background="{StaticResource FieldSurface}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="9" Padding="3,11" Margin="0,0,5,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Segment" Property="Background" Value="#E9E9E9" />
                <Setter TargetName="Segment" Property="BorderBrush" Value="#FFFFFF" />
                <Setter Property="Foreground" Value="#181818" />
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Segment" Property="BorderBrush" Value="#C9C9C9" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Segment" Property="BorderBrush" Value="White" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="OuterBorder" BorderBrush="#252525" BorderThickness="1" CornerRadius="22" ClipToBounds="True">
    <Border.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#090909" Offset="0" />
        <GradientStop Color="#030303" Offset="1" />
      </LinearGradientBrush>
    </Border.Background>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="58" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <local:SnowBackground x:Name="Snow" Grid.RowSpan="2" Opacity="0.38" />
      <Border Background="#060606" BorderBrush="#1D1D1D" BorderThickness="0,0,0,1" Padding="6,0" Margin="18,0">
        <Grid>
          <Button Click="ReplayCharacterClick" Background="Transparent" BorderThickness="0" Padding="0" Width="206" Height="40" HorizontalAlignment="Left" HorizontalContentAlignment="Left" ToolTip="Rejouer l’animation" shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <TextBlock x:Name="Wordmark" Text="larpclient.shop" FontSize="17" FontWeight="Bold" Foreground="#F5F5F5" VerticalAlignment="Center" Margin="6,0,0,0">
              </TextBlock>
          </Button>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
            <Button x:Name="DrawerToggle" Style="{StaticResource WindowButton}" Click="ToggleDrawerClick" ToolTip="Afficher ou masquer les instances" Margin="0,0,12,0">
              <Path Data="M 1,1 L 17,1 17,15 1,15 Z M 11,1 L 11,15" Stroke="#A5A5A5" StrokeThickness="1.3" Width="17" Height="15" />
            </Button>
            <Button Style="{StaticResource WindowButton}" Click="MinimizeClick" ToolTip="Réduire">
              <Path Data="M 0,5 L 10,5" Stroke="#C0C0C0" StrokeThickness="1.2" Width="10" Height="10" />
            </Button>
            <Button Style="{StaticResource WindowButton}" Click="MaximizeClick" ToolTip="Agrandir ou restaurer">
              <Rectangle Stroke="#C0C0C0" StrokeThickness="1.2" Width="10" Height="10" RadiusX="2" RadiusY="2" />
            </Button>
            <Button Style="{StaticResource WindowButton}" Click="CloseClick" ToolTip="Fermer">
              <Path Data="M 1,1 L 10,10 M 10,1 L 1,10" Stroke="#C0C0C0" StrokeThickness="1.3" Width="11" Height="11" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1" Margin="18,18,18,18">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border x:Name="NavigationRail" Width="186" BorderBrush="#1B1B1B" BorderThickness="0,0,1,0" ClipToBounds="True">
          <Grid Margin="0,0,16,0">
            <Grid.RowDefinitions>
              <RowDefinition Height="48" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Button Width="36" Height="32" Padding="8" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" Click="ToggleNavClick" ToolTip="Déplier ou replier le menu">
              <Path Data="M 1,3 L 17,3 M 1,9 L 12,9 M 1,15 L 17,15" Stroke="#939393" StrokeThickness="1.5" Width="18" Height="18" />
            </Button>
            <Grid Grid.Row="1" VerticalAlignment="Top" Width="168" HorizontalAlignment="Left">
              <Border x:Name="NavIndicator" Height="54" Margin="0,2,0,0" VerticalAlignment="Top" Background="{StaticResource RaisedSurface}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="13">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="NavMotion" />
                </Border.RenderTransform>
              </Border>
              <StackPanel>
                <Button Style="{StaticResource NavigationButton}" Tag="0" Click="NavigateClick" ToolTip="Jouer">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="M 3,1 L 18,10 3,19 Z" Stroke="White" StrokeThickness="1.6" Width="20" Height="20" />
                    <TextBlock Text="Jouer" Margin="20,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource NavigationButton}" Tag="1" Click="NavigateClick" ToolTip="Apparence">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="M 6,1 L 14,1 14,8 6,8 Z M 3,20 L 3,12 17,12 17,20 M 8,12 L 8,20 M 12,12 L 12,20" Stroke="#D6D6D6" StrokeThickness="1.5" Width="20" Height="21" />
                    <TextBlock Text="Apparence" Margin="20,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource NavigationButton}" Tag="2" Click="NavigateClick" ToolTip="Instances">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="M 1,6 L 10,1 19,6 19,16 10,21 1,16 Z M 1,6 L 10,11 19,6 M 10,11 L 10,21" Stroke="#D6D6D6" StrokeThickness="1.5" Width="20" Height="21" />
                    <TextBlock Text="Instances" Margin="20,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <Button Style="{StaticResource NavigationButton}" Tag="3" Click="NavigateClick" ToolTip="Réglages">
                  <StackPanel Orientation="Horizontal">
                    <Path Data="M 4,1 L 4,20 M 10,1 L 10,20 M 17,1 L 17,20 M 1,6 L 7,6 M 7,15 L 13,15 M 14,8 L 20,8" Stroke="#D6D6D6" StrokeThickness="1.5" Width="20" Height="21" />
                    <TextBlock Text="Réglages" Margin="20,0,0,0" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </Grid>
        </Border>
        <Grid Grid.Column="1" Margin="24,6,24,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid x:Name="PlayPage" Grid.Row="0" Opacity="0">
            <Grid.RenderTransform>
              <TranslateTransform x:Name="PageMotion" />
            </Grid.RenderTransform>
            <Grid.RowDefinitions>
              <RowDefinition Height="28" />
              <RowDefinition Height="*" />
              <RowDefinition Height="122" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="1" x:Name="CharacterStage">
              <Ellipse Width="350" Height="350" IsHitTestVisible="False">
                <Ellipse.Fill>
                  <RadialGradientBrush>
                    <GradientStop Color="#24242424" Offset="0" />
                    <GradientStop Color="#0D171717" Offset="0.65" />
                    <GradientStop Color="#00141414" Offset="1" />
                  </RadialGradientBrush>
                </Ellipse.Fill>
              </Ellipse>
              <Ellipse Width="254" Height="38" Fill="#000000" Opacity="0.7" VerticalAlignment="Bottom" Margin="0,0,0,18" IsHitTestVisible="False">
                <Ellipse.Effect>
                  <BlurEffect Radius="16" />
                </Ellipse.Effect>
              </Ellipse>
              <Ellipse x:Name="Orbit" Width="330" Height="72" Stroke="#404040" StrokeThickness="0.8" StrokeDashArray="1,10" VerticalAlignment="Bottom" Margin="0,0,0,20" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                  <RotateTransform Angle="-8" />
                </Ellipse.RenderTransform>
              </Ellipse>
              <Rectangle x:Name="SparkOne" Width="4" Height="4" Fill="#6B6B6B" Opacity="0.55" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="45,0,0,100" RenderTransformOrigin="0.5,0.5">
                <Rectangle.RenderTransform>
                  <TransformGroup>
                    <RotateTransform Angle="45" />
                    <TranslateTransform />
                  </TransformGroup>
                </Rectangle.RenderTransform>
              </Rectangle>
              <Rectangle x:Name="SparkTwo" Width="3" Height="3" Fill="#5A5A5A" Opacity="0.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,110,40,0">
                <Rectangle.RenderTransform>
                  <TranslateTransform />
                </Rectangle.RenderTransform>
              </Rectangle>
              <local:SkinScene x:Name="Character" MaxWidth="480" Margin="0,-12,0,12" />
            </Grid>
            <StackPanel x:Name="PlayActions" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Width="260">
              <Button x:Name="InstancePicker" Click="InstancePickerClick" Padding="14,10" Background="{StaticResource Surface}" Margin="0,0,0,10" ToolTip="Choisir une instance">
                <Grid Width="226">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="16" />
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="SelectedInstanceLabel" Text="Latest · 26.2" TextTrimming="CharacterEllipsis" FontSize="12" />
                  <Path Grid.Column="1" Data="M 1,2 L 6,7 11,2" Stroke="#A8A8A8" StrokeThickness="1.4" Width="12" Height="9" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <Button x:Name="LaunchButton" Click="LaunchClick" Background="#F2F2F2" Foreground="#111111" BorderBrush="#F2F2F2" Height="54" Padding="20,0">
                <StackPanel Orientation="Horizontal">
                  <Path Data="M 1,1 L 13,8 1,15 Z" Fill="#161616" Width="14" Height="16" VerticalAlignment="Center" Margin="0,0,12,0" />
                  <TextBlock x:Name="LaunchLabel" Text="JOUER" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </StackPanel>
            <Border x:Name="AppearanceBar" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="12" Padding="6">
              <StackPanel Orientation="Horizontal">
                <Button Content="Importer un skin" Click="ImportSkinClick" Padding="12,7" Background="Transparent" BorderThickness="0" FontSize="11" />
                <Button Content="Skin du compte" Click="ResetSkinClick" Padding="12,7" Background="Transparent" BorderThickness="0" FontSize="11" />
              </StackPanel>
            </Border>
          </Grid>
          <Border x:Name="SettingsPage" Grid.Row="0" Visibility="Collapsed" VerticalAlignment="Top" Background="{StaticResource Surface}" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="18" Padding="24" Margin="0,16,0,0">
            <StackPanel>
              <CheckBox x:Name="AnimationToggle" Content="Animations de l’interface" Click="PreferencesChanged" />
              <CheckBox x:Name="RotationToggle" Content="Rotation automatique du skin" Click="PreferencesChanged" />
              <CheckBox x:Name="BlurToggle" Content="Flou de mouvement" Click="PreferencesChanged" />
              <Button x:Name="LoginButton" Content="Se connecter à Microsoft" Click="LoginClick" Margin="0,20,0,8" Padding="12" />
              <Button x:Name="LogoutButton" Content="Déconnexion" Click="LogoutClick" Padding="12" />
            </StackPanel>
          </Border>
        </Grid>
        <Grid Grid.Column="2" x:Name="DrawerHost" Width="304" ClipToBounds="True">
          <Border x:Name="Drawer" Width="304" Background="#0C0C0C" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="20" Padding="18" HorizontalAlignment="Left">
            <Border.RenderTransform>
              <TranslateTransform x:Name="DrawerMotion" />
            </Border.RenderTransform>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid Margin="0,0,0,18">
                <TextBlock Text="Instances" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <Button Width="94" Height="36" Padding="0" HorizontalAlignment="Right" Background="{StaticResource RaisedSurface}" Click="CreateInstanceClick" ToolTip="Créer une instance" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" FontWeight="ExtraBold" Content="+ Créer" />
              </Grid>
              <StackPanel Grid.Row="1">
                <Border x:Name="CreateForm" Visibility="Collapsed" Background="{StaticResource Surface}" CornerRadius="16" Padding="14" Margin="0,0,0,14" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1">
                  <StackPanel>
                    <TextBlock Text="Nom" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                    <TextBox x:Name="NewInstanceName" MaxLength="28" ToolTip="Nom de l’instance" Text="Mon instance" Padding="12,12" Margin="0,0,0,16" />
                    <TextBlock Text="Version" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                    <UniformGrid Columns="3" Margin="0,0,-5,0">
                      <RadioButton x:Name="CreateVersion189" Content="1.8.9" GroupName="NewVersion" />
                      <RadioButton x:Name="CreateVersion121" Content="1.21.11" GroupName="NewVersion" />
                      <RadioButton Content="26.2" GroupName="NewVersion" IsChecked="True" />
                    </UniformGrid>
                    <Button Content="Créer l’instance" Click="ConfirmCreateClick" Padding="10,12" Margin="0,16,0,0" Background="#E9E9E9" BorderBrush="White" Foreground="#161616" FontWeight="ExtraBold" />
                  </StackPanel>
                </Border>
              </StackPanel>
              <ListBox x:Name="InstanceList" Grid.Row="2" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource InstanceCard}" SelectionChanged="InstanceSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="0" />
              <StackPanel Grid.Row="3" Margin="0,16,0,0">
                <Border Background="#232323" Height="1" Margin="0,0,0,16" />
                <StackPanel x:Name="OperationPanel" Visibility="Collapsed" Margin="0,0,0,12">
                  <TextBlock x:Name="InstallationStatus" Foreground="#C8C8C8" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8" />
                  <ProgressBar x:Name="InstallationProgress" Height="4" Foreground="#EAEAEA" Background="#292929" BorderThickness="0" Maximum="100" />
                  <Button x:Name="CancelOperationButton" Content="Annuler" Click="CancelOperationClick" Padding="6" Margin="0,8,0,0" Background="Transparent" BorderThickness="0" FontSize="11" />
                </StackPanel>
                <Button x:Name="InstallButton" Content="Installer / vérifier" Click="InstallClick" Padding="8,11" Background="{StaticResource RaisedSurface}" FontSize="12" Margin="0,0,0,8" />
                <Button Content="Ouvrir le dossier  ↗" Click="OpenFolderClick" Padding="8,11" Background="{StaticResource Surface}" FontSize="11" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Popup x:Name="InstancePopup" PlacementTarget="{Binding ElementName=InstancePicker}" Placement="Top" StaysOpen="False" AllowsTransparency="True" VerticalOffset="-8" Opened="InstancePopupOpened" PopupAnimation="None">
        <Border x:Name="PopupSurface" Width="260" Padding="10" Background="#111111" BorderBrush="{StaticResource SurfaceBorder}" BorderThickness="1" CornerRadius="16">
          <Border.RenderTransform>
            <TranslateTransform x:Name="PopupMotion" />
          </Border.RenderTransform>
          <ListBox x:Name="PopupInstanceList" MaxHeight="280" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource InstanceCard}" SelectionChanged="PopupSelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="PopupItemClick" PreviewKeyDown="PopupKeyDown" />
        </Border>
      </Popup>
      <Grid x:Name="StatusOverlay" Grid.RowSpan="2" Panel.ZIndex="50" Visibility="Collapsed" Background="#B0000000">
        <Border Width="440" MaxWidth="520" Padding="24" Background="#111111" BorderBrush="#383838" BorderThickness="1" CornerRadius="18" HorizontalAlignment="Center" VerticalAlignment="Center" KeyboardNavigation.TabNavigation="Cycle">
          <StackPanel>
            <TextBlock Text="LarpClient" FontSize="18" FontWeight="Bold" Margin="0,0,0,16" />
            <TextBlock x:Name="StatusMessage" Foreground="#EEEEEE" TextWrapping="Wrap" FontSize="14" LineHeight="22" />
            <Button x:Name="StatusApprovalButton" Content="Autorisation Minecraft" Click="OpenApprovalClick" Visibility="Collapsed" Padding="12" Margin="0,18,0,0" />
            <Button x:Name="StatusDismissButton" Content="Fermer" Click="DismissStatusClick" Background="#EEEEEE" Foreground="#181818" Padding="12" Margin="0,12,0,0" />
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
