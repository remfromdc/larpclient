{
	"schemaVersion": 1,
	"id": "larpclient",
	"version": "${version}",
	"name": "LarpClient",
	"description": "LarpClient — a client-side Fabric mod with a custom title screen and an in-game ClickGUI.",
	"authors": [
		"LarpClient"
	],
	"license": "CC0-1.0",
	"icon": "assets/larpclient/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"dev.larp.Larp"
		],
		"client": [
			"dev.larp.client.LarpClient"
		]
	},
	"mixins": [
		{
			"config": "larpclient.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}
